rule cxx
  command = ../../toolchain/bin/clang++ -MMD -MF ${out}.d -c ${in} -o ${out}
  deps = gcc
  depfile = ${out}.d

build obj/foo.o: cxx ../../src/foo.cc

build all: phony obj/foo.o

build build.ninja: phony
