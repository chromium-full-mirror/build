# String length
assert(len("") == 0)
assert(len("foo") == 3)

# List length
assert(len([]) == 0)
assert(len(["a", "b"]) == 2)
assert(len([1, 2, 3, 4]) == 4)

assert_failure("Expecting exactly one argument.") {
    len()
}

assert_failure("Expecting exactly one argument.") {
    len("a", "b")
}

assert_failure("len() expects a string or a list.", "Got integer instead.") {
    len(123)
}

assert_failure("len() expects a string or a list.", "Got boolean instead.") {
    len(true)
}
