out1 = string_replace("abbcc", "b", "d")
assert(out1 == "addcc")

out2 = string_replace("abbcc", "b", "d", 1)
assert(out2 == "adbcc")

out3 = string_replace("abbcc", "b", "bb")
assert(out3 == "abbbbcc")

out4 = string_replace("aaa", "aa", "b")
assert(out4 == "ba")

assert_failure("Requested number of replacements is not positive.") {
  string_replace("a", "a", "b", 0)
}

assert_failure("Requested number of replacements is not positive.") {
  string_replace("a", "a", "b", -1)
}

assert_failure("Wrong number of arguments to string_replace().") {
  string_replace("a")
}

assert_failure("Wrong number of arguments to string_replace().") {
  string_replace("a", "a")
}

assert_failure("Wrong number of arguments to string_replace().") {
  string_replace("a", "a", "b", 3, "d")
}

