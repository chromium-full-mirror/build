# basic arithmetic
# TODO: operators other than +
assert(0 + 1 == 1)
assert(1 + 1 == 2)
assert(5 + 7 == 12)

# comparisons
assert(1 > 0)

assert_failure("Negative zero doesn't make sense") {
    negative_zero = -0
}

assert_failure("Leading zeros not allowed") {
    leading_zero = 01
}

int64_max = 9223372036854775807
assert_failure("This does not look like an integer") {
    int64_over = 9223372036854775808
}

int64_min = -9223372036854775808
assert_failure("This does not look like an integer") {
    int64_under = -9223372036854775809
}
