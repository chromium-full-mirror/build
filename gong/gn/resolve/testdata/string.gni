# str + str
assert("a" + "b" == "ab")
assert("a" + "b" + "c" == "abc")

# str + int,  int + str
assert("1" + 1 == "11")
assert(1 + "1" == "11")

# str + invalid,  invalid + str
assert_failure("Incompatible types for binary operator.", "You can't do <string> + <boolean>.") {
    invalid = "1" + true
}
assert_failure("Incompatible types for binary operator.", "You can't do <boolean> + <string>.") {
    invalid = true + "1"
}

# str += str
s = "foo"
s += "bar"
assert(s == "foobar")

# str += int
s += 1
assert(s == "foobar1")

# str += invalid
assert_failure("Incompatible types for binary operator.", "You can't do <string> += <boolean>.") {
    s += true
}

# int + str is okay, but int += str is not
assert_failure("Incompatible types for binary operator.", "You can't do <integer> += <string>.") {
    i = 1
    i += "1"
}

# hex
assert("$0x41" == "A")

assert_failure("\$ at end of string.") {
    invalid = "foo$"
}

assert_failure("\$identifier interpolation not implemented") {
    unimplemented = "$foo"
}
